; ============================================================
; Glee GPMS — config.ini.example
; Copy to config/config.ini and fill in real values.
; config/config.ini is gitignored — never commit real credentials.
; ============================================================

[app]
name = "GatePass Management System"
env = local
debug = false
url = "http://localhost"
timezone = "Africa/Nairobi"

[mysql]
host = 127.0.0.1
port = 3306
username = ""
password = ""

[database]
host = 127.0.0.1
port = 3306
name = glee_tenant_default
username = ""
password = ""
charset = utf8mb4
persistent = false

[directadmin]
host = ""
port = 2222
username = ""
login_key = ""
verify_ssl = true
runtime_db_user = ""

[master_db]
host = 127.0.0.1
port = 3306
name = glee_master
username = ""
password = ""

[platform]
base_domain = ""
admin_subdomain = "manage"

[tenant]
code = ""
name = "Glee GPMS"
plan = "starter"
logo = "/assets/images/default-logoo.png"

[gatepass]
prefix = "GP"
zero_pad = 5

[session]
name = glee_session
lifetime = 7200
httponly = true
secure = false
samesite = Strict

[security]
login_max_attempts = 5
login_lockout_seconds = 300
reset_max_attempts = 5
reset_lockout_seconds = 900
scan_max_attempts = 60
scan_lockout_seconds = 60
approval_max_attempts = 30
approval_lockout_seconds = 60
admin_mutation_max_attempts = 60
admin_mutation_lockout_seconds = 60
bcrypt_rounds = 12
; Lifetime of opaque QR credentials. 1 day by default; valid range is 60..2592000 seconds.
qr_ttl_seconds = 86400
trusted_proxies = ""

[features]
badges = true
qr_codes = true
risk_engine = true

[mail]
driver = log
host = ""
port = 587
encryption = tls
username = ""
password = ""
timeout = 10
from_address = "no-reply@glee-gpms.local"
from_name = "Glee GPMS"

[qr]
; QR images are cached locally; the generator is not required during scanning.
service_url = "http://127.0.0.1:8081"
timeout_seconds = 5

[audit]
retention_days = 365

[tenant_admin]
email = ""
first_name = "Admin"
last_name = ""
password = ""
